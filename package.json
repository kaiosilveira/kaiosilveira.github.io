{
  "name": "kaiosilveira.github.io",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "jest": {
    "testEnvironment": "jest-environment-jsdom",
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": {
            "jsx": "react-jsx",
            "esModuleInterop": true,
            "isolatedModules": true
          }
        }
      ]
    },
    "moduleNameMapper": {
      "\\.(jpg|jpeg|png|gif|eot|otf|webp|svg|ttf|woff|woff2|mp4|webm|wav|mp3|m4a|aac|oga)$": "<rootDir>/src/__mocks__/file_mock.cjs",
      "\\.(css|less)$": "<rootDir>/src/__mocks__/style_mock.cjs"
    },
    "setupFilesAfterEnv": [
      "<rootDir>/setup_jest.ts"
    ]
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "jest",
    "test:unit": "jest",
    "t": "jest",
    "og-image": "node scripts/og-image.mjs",
    "favicons": "node scripts/favicons.mjs"
  },
  "dependencies": {
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "playwright": "^1.65.0",
    "ts-jest": "^29.4.15",
    "typescript": "~5.9.3",
    "vite": "^8.3.6"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
